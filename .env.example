# ── Session (REQUIRED — app refuses to start with a weak secret) ──
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
COOKIE_SECURE=true                 # true in production (https). false for local http.

# ── Access ──
ALLOWED_DOMAIN=digilatics.com
BASE_URL=https://time.digilatics.com

# ── Google OAuth (Sign in with Google) ──
# Only users already in users.json may sign in (domain alone is not enough).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# ── Postgres ──
DATABASE_URL=postgresql+psycopg2://time:time@localhost:5432/time

# ── ClickUp sync ──
CLICKUP_API_TOKEN=pk_xxx
CLICKUP_TEAM_ID=25658037
CLICKUP_LOOKBACK_DAYS=14

# ── Google Calendar / Meet sync (service account + domain-wide delegation) ──
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_ADMIN_EMAIL=ambreen@digilatics.com
MEET_EXCLUDE_EMAILS=khurram@digilatics.com,growth@digilatics.com
# MEET_SINGLE_DAY=2025-04-01   # optional backfill day; leave unset for "today" ET

# ── Reference sheets still used for client/employee matching (phase 1) ──
MASTER_SHEET_ID=1Nk-LHFQSwXNDBBBq0tAj471ZE6zJu2C-soVFmjlBDO4
EMPLOYEE_SHEET_ID=1dpZzyBAf9NwT2_XXsEN8443xfrEV5qeYxKjZhZLSw1c
LAUNCHPAD_SHEET_ID=1aXVaq39R6wsB0wgAAF_nxnuq6gqaRqmI1oHi5qqLpdI
SHEET_ID=1Aw7efJ_Z0VHiHH9iR2cm-HsP2OA_4hQCxeekSimSasY

# ── Scheduler ──
ENABLE_SCHEDULER=true
SYNC_CLICKUP_MINUTES=30
SYNC_MEET_MINUTES=30
CACHE_TTL_SECONDS=60

# ── Local dev only — NEVER set true in production ──
# Even when true, /login?as= only works from localhost and only for users.json emails.
DEV_LOGIN=false
ENABLE_FUZZY_MATCH=false

# ── Claude Haiku (ambiguous client matching) ──
ANTHROPIC_API_KEY=
ENABLE_CLAUDE_MATCH=true
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MIN_CONFIDENCE=0.7
EMPLOYEE_LIST_FILE=Digilatics_Employee_List.xlsx
# Local client list (preferred over MASTER_SHEET_ID Google Sheet)
CLIENTS_FILE=clients.json

# ── Local LLM (Ollama — CPU-friendly chat + identity hints) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
ENABLE_LOCAL_LLM=true
# First-time: ollama pull qwen2.5:0.5b  (~400MB, runs on CPU)
